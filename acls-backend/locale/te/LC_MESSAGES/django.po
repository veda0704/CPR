#: .\acls\views.py:181
msgid "Is the scene safe?"
msgstr "సీన్ సురక్షితమా?"

#: .\acls\views.py:182
msgid "Is the patient responsive?"
msgstr "రోగి ప్రతిస్పందిస్తున్నారా?"

#: .\acls\views.py:183
msgid "Did you see the person collapse?"
msgstr "వ్యక్తి పడిపోవడం మీరు చూశారా?"

#: .\acls\views.py:184 .\templates\acls\breathing_after_pulse.html:4
msgid "Is the patient breathing normally?"
msgstr "రోగి సాధారణంగా శ్వాస తీసుకుంటున్నారా?"

#: .\acls\views.py:185
msgid "Is a pulse present (within 10 seconds)?"
msgstr "పల్స్ ఉందా (10 సెకండ్లలోపు)?"

#: .\acls\views.py:186
msgid "Is the rhythm Ventricular Fibrillation (VF)?"
msgstr "రిద్దమ్ వెంట్రిక్యులర్ ఫిబ్రిలేషన్ (VF) అనేదా?"

#: .\acls\views.py:187
msgid "Is the rhythm Pulseless Ventricular Tachycardia (VT)?"
msgstr "రిద్దమ్ పల్స్ లేని వెంట్రిక్యులర్ టాకికార్డియా (VT) అనేదా?"

#: .\acls\views.py:188
msgid "Is the rhythm Asystole?"
msgstr "రిద్దమ్ అసిస్టోల్ అనేదా?"

#: .\acls\views.py:189
#, fuzzy
#| msgid "Pulseless Electrical Activity (PEA)"
msgid "Is the rhythm Pulseless Electrical Activity (PEA)?"
msgstr "పల్స్ లేని ఎలక్ట్రికల్ యాక్టివిటీ (PEA)"

#: .\templates\acls\adenosine_admin.html:5
msgid "Adenosine Administration"
msgstr "అడెనోసిన్ అడ్మినిస్ట్రేషన్"

#: .\templates\acls\adenosine_admin.html:6
msgid "Administer adenosine for SVT."
msgstr "SVT కోసం అడెనోసిన్ అడ్మినిస్టర్ చేయండి."

#: .\templates\acls\adenosine_admin.html:9
#: .\templates\acls\cardioversion.html:9
#: .\templates\acls\observe_bradycardia.html:9
#: .\templates\acls\pacing_started.html:9
#: .\templates\acls\sinus_rhythm_workflow.html:9
msgid "End Session"
msgstr "సెషన్ ముగించు"

#: .\templates\acls\airway.html:4
msgid "Open Airway"
msgstr "వాయుమార్గాన్ని తెరవండి"

#: .\templates\acls\airway.html:7 .\templates\acls\breaths.html:7
#: .\templates\acls\call108.html:8 .\templates\acls\recovery.html:7
msgid "OK"
msgstr "సరే"

#: .\templates\acls\analyze_rhythm.html:4
msgid "Analyze Heart Rhythm"
msgstr "హృదయ రిద్దమ్ విశ్లేషించండి"

#: .\templates\acls\analyze_rhythm.html:5
msgid ""
"The monitor shows the heart rhythm. Further ACLS steps are performed based "
"on that rhythm."
msgstr "మానిటర్ హృదయ రిద్దమ్ చూపిస్తుంది. ఆ రిద్దమ్ ఆధారంగా మరిన్ని ACLS దశలు నిర్వహించబడతాయి."

#: .\templates\acls\analyze_rhythm.html:8
#: .\templates\acls\attach_monitor.html:8 .\templates\acls\cpr.html:8
msgid "Continue"
msgstr "కొనసాగించు"

#: .\templates\acls\arrest_witnessed.html:4
msgid "Was the arrest witnessed?"
msgstr "అరెస్ట్ చూసారా?"

#: .\templates\acls\arrest_witnessed.html:7 .\templates\acls\breathing.html:7
#: .\templates\acls\breathing_after_pulse.html:7
#: .\templates\acls\defibrillator.html:7
#: .\templates\acls\guided_checklist.html:14 .\templates\acls\protection.html:7
#: .\templates\acls\pulse.html:7 .\templates\acls\response.html:7
#: .\templates\acls\responsive.html:7 .\templates\acls\witnessed.html:8
msgid "YES"
msgstr "అవును"

#: .\templates\acls\arrest_witnessed.html:8 .\templates\acls\breathing.html:8
#: .\templates\acls\breathing_after_pulse.html:8
#: .\templates\acls\defibrillator.html:8
#: .\templates\acls\guided_checklist.html:15 .\templates\acls\protection.html:8
#: .\templates\acls\pulse.html:8 .\templates\acls\response.html:8
#: .\templates\acls\responsive.html:8 .\templates\acls\witnessed.html:9
msgid "NO"
msgstr "కాదు"

#: .\templates\acls\asystole_epinephrine.html:5
msgid "Asystole Epinephrine Administration"
msgstr "అసిస్టోల్ ఎపినెఫ్రిన్ అడ్మినిస్ట్రేషన్"

#: .\templates\acls\asystole_epinephrine.html:6
msgid ""
"Administer epinephrine for asystole as per protocol. Proceed when ready."
msgstr "అసిస్టోల్ కోసం ప్రోటోకాల్ ప్రకారం ఎపినెఫ్రిన్ అడ్మినిస్టర్ చేయండి. సిద్ధంగా ఉన్నప్పుడు కొనసాగించండి."

#: .\templates\acls\asystole_epinephrine.html:9
#: .\templates\acls\bradycardia_treatment.html:11
#: .\templates\acls\bradycardia_workflow.html:11
#: .\templates\acls\check_bp.html:11 .\templates\acls\ecg_evaluation.html:9
#: .\templates\acls\pacing_effectiveness.html:11
#: .\templates\acls\pea_epinephrine.html:9
#: .\templates\acls\perfusion_check.html:11
#: .\templates\acls\prepare_pacing.html:9 .\templates\acls\rhythm.html:24
#: .\templates\acls\rhythm_classification.html:12
#: .\templates\acls\tachycardia_pulse_workflow.html:11
#: .\templates\acls\tachycardia_stable.html:11 .\templates\acls\vf_drugs.html:9
#: .\templates\acls\vt_no_pulse_drugs.html:9
#: .\templates\acls\vt_pulse_irregular_treatment.html:15
#: .\templates\acls\vt_pulse_regularity.html:11
#: .\templates\acls\vt_pulse_workflow.html:12
msgid "Proceed"
msgstr "కొనసాగించు"

#: .\templates\acls\asystole_workflow.html:5
msgid "Asystole Workflow"
msgstr "అసిస్టోల్ వర్క్‌ఫ్లో"

#: .\templates\acls\asystole_workflow.html:6
msgid "Perform CPR cycles, epinephrine every 3-5 minutes."
msgstr "CPR సైకిల్స్ నిర్వహించండి, ఎపినెఫ్రిన్ ప్రతి 3-5 నిమిషాలకు."

#: .\templates\acls\asystole_workflow.html:9
#: .\templates\acls\pea_workflow.html:9 .\templates\acls\vf_workflow.html:10
#: .\templates\acls\vt_no_pulse_workflow.html:10
msgid "Continue CPR"
msgstr "CPR కొనసాగించు"

#: .\templates\acls\atropine_admin.html:5
msgid "Atropine Administration"
msgstr "అట్రోపిన్ అడ్మినిస్ట్రేషన్"

#: .\templates\acls\atropine_admin.html:6
msgid "Administer atropine at defined intervals."
msgstr "నిర్వచించిన విరామాల్లో అట్రోపిన్ అడ్మినిస్టర్ చేయండి."

#: .\templates\acls\atropine_admin.html:9
msgid "Recheck"
msgstr "మళ్లీ తనిఖీ చేయండి"

#: .\templates\acls\attach_monitor.html:4
msgid "Attach Monitor and Defibrillator Pads"
msgstr "మానిటర్ మరియు డిఫిబ్రిలేటర్ ప్యాడ్‌లను అటాచ్ చేయండి"

#: .\templates\acls\attach_monitor.html:5
msgid ""
"Attach the monitor and defibrillator pads. Do not touch the patient while "
"the machine analyzes the heart rhythm."
msgstr ""
"మానిటర్ మరియు డిఫిబ్రిలేటర్ ప్యాడ్‌లను అటాచ్ చేయండి. మెషీన్ హృదయ రిద్దమ్ విశ్లేషించేటప్పుడు రోగిని తాకవద్దు."

#: .\templates\acls\bradycardia_treatment.html:5
msgid "Bradycardia Treatment"
msgstr "బ్రాడికార్డియా చికిత్స"

#: .\templates\acls\bradycardia_treatment.html:6
msgid "Check pacing availability."
msgstr "పేసింగ్ లభ్యతను తనిఖీ చేయండి."

#: .\templates\acls\bradycardia_treatment.html:9
msgid "Pacing Available"
msgstr "పేసింగ్ లభ్యం"

#: .\templates\acls\bradycardia_treatment.html:10
msgid "Pacing Not Available"
msgstr "పేసింగ్ లభ్యం కాదు"

#: .\templates\acls\bradycardia_workflow.html:5
msgid "Bradycardia Workflow"
msgstr "బ్రాడికార్డియా వర్క్‌ఫ్లో"

#: .\templates\acls\bradycardia_workflow.html:6
msgid "Check Perfusion (Blood flow to organs)."
msgstr "పర్ఫ్యూషన్ స్థితిని తనిఖీ చేయండి."

#: .\templates\acls\bradycardia_workflow.html:9
#: .\templates\acls\perfusion_check.html:9
msgid "Adequate Perfusion"
msgstr "సరైన పర్ఫ్యూషన్"

#: .\templates\acls\bradycardia_workflow.html:10
msgid "Poor Perfusion"
msgstr "తక్కువ పర్ఫ్యూషన్"

#: .\templates\acls\breathing.html:4
msgid "Check Breathing"
msgstr "శ్వాసను పరిశీలించండి"

#: .\templates\acls\breaths.html:4
msgid "Give 2 Rescue Breaths"
msgstr "2 రెస్క్యూ శ్వాసలు ఇవ్వండి"

#: .\templates\acls\call108.html:4
msgid "Call 108"
msgstr "108కు కాల్ చేయండి"

#: .\templates\acls\call108.html:5
msgid "Please call emergency services 108."
msgstr "దయచేసి అత్యవసర సేవలు 108కు కాల్ చేయండి."

#: .\templates\acls\cardioversion.html:5
msgid "Cardioversion"
msgstr "కార్డియోవర్షన్"

#: .\templates\acls\cardioversion.html:6
msgid "Prepare for synchronized cardioversion."
msgstr "సింక్రొనైజ్డ్ కార్డియోవర్షన్ కోసం సిద్ధం చేయండి."

#: .\templates\acls\check_bp.html:5
msgid "Check Blood Pressure"
msgstr "రక్తపోటు తనిఖీ చేయండి"

#: .\templates\acls\check_bp.html:6
msgid "Enter Blood Pressure (Systolic & Diastolic)."
msgstr "రక్తపోటు (సిస్టాలిక్ మరియు డయాస్టాలిక్) నమోదు చేయండి."

#: .\templates\acls\check_bp.html:9
msgid "Systolic BP:"
msgstr "సిస్టాలిక్ బిపి:"

#: .\templates\acls\check_bp.html:10
msgid "Diastolic BP:"
msgstr "డయాస్టాలిక్ బిపి:"

#: .\templates\acls\cpr.html:4
msgid "Start CPR"
msgstr "CPRను ప్రారంభించండి"

#: .\templates\acls\cpr.html:5
msgid "Perform CPR immediately."
msgstr "వెంటనే CPR నిర్వహించండి."

#: .\templates\acls\cpr_cycle.html:5
msgid "CPR Cycle"
msgstr "CPR సైకిల్"

#: .\templates\acls\cpr_cycle.html:6
msgid "Perform CPR for 2 minutes, then reassess rhythm."
msgstr "2 నిమిషాల పాటు CPR నిర్వహించండి, తర్వాత రిద్దమ్ మళ్లీ విశ్లేషించండి."

#: .\templates\acls\cpr_cycle.html:9
msgid "Reassess Rhythm"
msgstr "రిద్దమ్ మళ్లీ విశ్లేషించు"

#: .\templates\acls\dashboard.html:4
msgid "Dashboard"
msgstr "డ్యాష్‌బోర్డ్"

#: .\templates\acls\dashboard.html:5
msgid "Welcome to the ACLS dashboard. Use the links below to begin."
msgstr "ACLS డ్యాష్‌బోర్డ్‌కు స్వాగతం. ప్రారంభించడానికి దిగువ లింక్‌లను ఉపయోగించండి."

#: .\templates\acls\dashboard.html:8 .\templates\acls\start.html:4
#: .\templates\acls\start_acls.html:4
msgid "Start ACLS"
msgstr "ACLSను ప్రారంభించండి"

#: .\templates\acls\dashboard.html:12
msgid "Logout"
msgstr "లాగ్ అవుట్"

#: .\templates\acls\defibrillator.html:4
msgid "Is a defibrillator available?"
msgstr "డిఫిబ్రిలేటర్ లభ్యమా?"

#: .\templates\acls\ecg_evaluation.html:5
msgid "ECG Evaluation"
msgstr "ECG విశ్లేషణ"

#: .\templates\acls\ecg_evaluation.html:6
msgid "Obtain 12-lead ECG if possible."
msgstr "సాధ్యమైతే 12-లీడ్ ECG పొందండి."

#: .\templates\acls\forgot_password.html:4
msgid "Forgot Password"
msgstr "పాస్‌వర్డ్ మర్చిపోయారా?"

#: .\templates\acls\forgot_password.html:20
msgid "Enter your email"
msgstr "మీ ఇమెయిల్ నమోదు చేయండి"

#: .\templates\acls\forgot_password.html:22
msgid "Resend OTP"
msgstr "OTP మళ్లీ పంపండి"

#: .\templates\acls\forgot_password.html:24
msgid "Enter OTP"
msgstr "OTP నమోదు చేయండి"

#: .\templates\acls\forgot_password.html:25
#: .\templates\registration\password_reset_confirm.html:10
msgid "New password"
msgstr "కొత్త పాస్‌వర్డ్"

#: .\templates\acls\forgot_password.html:26
msgid "Retype new password"
msgstr "కొత్త పాస్‌వర్డ్ మళ్లీ టైప్ చేయండి"

#: .\templates\acls\forgot_password.html:27
#: .\templates\registration\password_reset_confirm.html:4
msgid "Reset Password"
msgstr "పాస్‌వర్డ్ రీసెట్"

#: .\templates\acls\forgot_password.html:29
msgid "Generate OTP"
msgstr "OTP ఉత్పత్తి చేయండి"

#: .\templates\acls\forgot_password.html:34
#: .\templates\registration\password_reset_confirm.html:20
#: .\templates\registration\password_reset_done.html:11
msgid "Back to Sign In"
msgstr "సైన్ ఇన్‌కు తిరిగి వెళ్ళు"

#: .\templates\acls\guided_checklist.html:4
msgid "Guided ACLS Checklist"
msgstr "మార్గదర్శక ACLS చెక్‌లిస్ట్"

#: .\templates\acls\guided_checklist.html:8
msgid "Back to dashboard"
msgstr "డ్యాష్‌బోర్డ్‌కు తిరిగి వెళ్ళు"

#: .\templates\acls\login.html:4 .\templates\acls\signup.html:18
#: .\templates\registration\login.html:4
msgid "Sign In"
msgstr "సైన్ ఇన్"

#: .\templates\acls\login.html:12 .\templates\acls\signup.html:12
#: .\templates\registration\login.html:8
msgid "Email"
msgstr "ఇమెయిల్"

#: .\templates\acls\login.html:13 .\templates\acls\signup.html:13
#: .\templates\registration\login.html:9
msgid "Password"
msgstr "పాస్‌వర్డ్"

#: .\templates\acls\login.html:14 .\templates\registration\login.html:10
msgid "Login"
msgstr "లాగిన్"

#: .\templates\acls\login.html:18 .\templates\acls\signup.html:4
#: .\templates\registration\login.html:14
msgid "Sign Up"
msgstr "సైన్ అప్"

#: .\templates\acls\login.html:19 .\templates\registration\login.html:15
msgid "Forgot Password?"
msgstr "పాస్‌వర్డ్ మర్చిపోయారా?"

#: .\templates\acls\observe_bradycardia.html:5
msgid "Observe Bradycardia"
msgstr "బ్రాడికార్డియా గమనించండి"

#: .\templates\acls\observe_bradycardia.html:6
msgid "Monitor and observe the patient."
msgstr "రోగిని మానిటర్ చేసి గమనించండి."

#: .\templates\acls\pacing_effectiveness.html:5
msgid "Check Pacing Effectiveness"
msgstr "పేసింగ్ ప్రభావవంతతను తనిఖీ చేయండి"

#: .\templates\acls\pacing_effectiveness.html:6
msgid "Is the pacing effective? Check for improved perfusion and vital signs."
msgstr "పేసింగ్ ప్రభావవంతమా? మెరుగైన పర్ఫ్యూషన్ మరియు కీలక సంకేతాల కోసం తనిఖీ చేయండి."

#: .\templates\acls\pacing_effectiveness.html:9
msgid "Yes, effective"
msgstr "అవును, ప్రభావవంతం"

#: .\templates\acls\pacing_effectiveness.html:10
msgid "No, not effective"
msgstr "కాదు, ప్రభావవంతం కాదు"

#: .\templates\acls\pacing_started.html:5
msgid "Pacing Started"
msgstr "పేసింగ్ ప్రారంభించబడింది"

#: .\templates\acls\pacing_started.html:6
msgid "Transcutaneous pacing has been initiated."
msgstr "ట్రాన్స్‌క్యూటేనియస్ పేసింగ్ ప్రారంభించబడింది."

#: .\templates\acls\pea_epinephrine.html:5
msgid "PEA Epinephrine Administration"
msgstr "PEA ఎపినెఫ్రిన్ అడ్మినిస్ట్రేషన్"

#: .\templates\acls\pea_epinephrine.html:6
msgid "Administer epinephrine for PEA as per protocol. Proceed when ready."
msgstr "PEA కోసం ప్రోటోకాల్ ప్రకారం ఎపినెఫ్రిన్ అడ్మినిస్టర్ చేయండి. సిద్ధంగా ఉన్నప్పుడు కొనసాగించండి."

#: .\templates\acls\pea_workflow.html:5
msgid "PEA Workflow"
msgstr "PEA వర్క్‌ఫ్లో"

#: .\templates\acls\pea_workflow.html:6
msgid "Perform CPR cycles. Administer epinephrine every 3-5 minutes."
msgstr "CPR సైకిల్స్ నిర్వహించండి. ఎపినెఫ్రిన్ ప్రతి 3-5 నిమిషాలకు అడ్మినిస్టర్ చేయండి."

#: .\templates\acls\perfusion_check.html:5
msgid "Perfusion Check"
msgstr "పర్ఫ్యూషన్ తనిఖీ"

#: .\templates\acls\perfusion_check.html:6
